# =============================================================================
# Civora — Environment Variables
# =============================================================================
#
# Operating modes:
#
#   STATELESS (Gemini only)
#     Requires only GEMINI_API_KEY.
#     Supports POST /chat, core chatbot, Arena evaluator.
#
#   PERSISTENT (Gemini + Supabase)
#     Requires GEMINI_API_KEY + Supabase vars.
#     Adds chat history, multiple conversations, saved specialist modes.
#
# =============================================================================

# ---------------------------------------------------------------------------
# CLIENT — copy relevant vars to client/.env (or set in Vercel dashboard)
# ---------------------------------------------------------------------------

# URL of the backend API. Required in production — must be redeployed when changed.
# Vite injects this at build time, so a frontend redeploy is needed after editing.
VITE_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# SERVER — copy relevant vars to server/.env (or set in Render dashboard)
# ---------------------------------------------------------------------------

# Port the Express server listens on (default: 3001)
=======
>>>>>>> 75dee41389d103de26db4911f52b4af2ec416f7f:server/.env.example
PORT=3001

# REQUIRED — Gemini API key. Without this the chatbot cannot generate responses.
GEMINI_API_KEY=

# Optional — Gemini model name. Defaults to gemini-2.5-flash if not set.
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL — Supabase connection details.
# If absent, Civora uses an in-memory store (conversations reset on restart).
# Required only for persistent chat history.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
